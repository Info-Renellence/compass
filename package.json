{
  "name": "compass",
  "version": "0.1.0",
  "private": true,
  "description": "Compass: Renellence's weekly and monthly 1-on-1 app (React + Vite, same stack as Edge's web app)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "shots": "node scripts/shots.mjs",
    "test:db": "node --require ./test/run/no-network.js test/run/db-compass.test.js",
    "test:ui": "node --require ./test/run/no-network.js --test test/ui-steps.test.mjs",
    "serve:test": "node --require ./test/run/no-network.js test/run/serve.js"
  },
  "dependencies": {
    "google-auth-library": "^9.15.1",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "playwright": "^1.48.2",
    "vite": "^6.3.5"
  }
}
